#!/bin/sh
# Toggle dark and light themes for tmux, Alacritty, and Neovim on macOS and Linux.
# On Linux with a graphical session (Cinnamon/GNOME), also switches the desktop theme.
# On headless Linux, tracks state in a file.
#
# Usage: toggledark [light|dark|toggle]
#   no argument / toggle  flip to the opposite of the current mode
#   light | dark          set that mode explicitly
#
# When devvm (github.com/smweber/devvm) is installed, the chosen mode is also
# pushed into every running local dev VM that has its own toggledark.

case "${1:-toggle}" in
  toggle) MODE="toggle" ;;
  light)  MODE="light" ;;
  dark)   MODE="dark" ;;
  -h | --help)
    echo "usage: toggledark [light|dark|toggle]"
    exit 0
    ;;
  *)
    echo "toggledark: unknown mode '$1' (want light, dark, or toggle)" >&2
    exit 1
    ;;
esac

ALACRITTY_LIGHTTHEME="catppuccin_latte.toml"
ALACRITTY_DARKTHEME="catppuccin.toml"
ALACRITTY_THEMES="$HOME/.config/alacritty/themes/themes"
# Untracked override imported by ~/.alacritty.toml (see dot-alacritty.toml). We
# copy the chosen theme here instead of editing the tracked config.
ALACRITTY_ACTIVE="$HOME/.alacritty-theme.toml"
ALACRITTY_CONF="$HOME/.alacritty.toml" # primary config; touched to force reload

TMUXCONF="$HOME/.tmux-catppuccin.conf" # standalone theme file (see dot-tmux.conf)
THEME_MODE_FILE="$HOME/.theme_mode"

# nvim and tmux read the mode from THEME_MODE_FILE themselves (see init.lua and
# dot-tmux-catppuccin.conf); alacritty imports ALACRITTY_ACTIVE. So we only write
# state/override files and reload - we never rewrite a tracked config.
REAL_TMUXCONF=$(readlink -f "$TMUXCONF" 2>/dev/null || echo "$TMUXCONF")

OS_TYPE=$(uname)
HAS_DISPLAY=false
[ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ] && HAS_DISPLAY=true

# Pick which tmux server to drive for the live repaint. Inside tmux, use that
# session's own socket. Otherwise, when run non-interactively inside a devvm
# guest (e.g. `devvm exec NAME toggledark dark` from the host), the persistent
# dev session lives on devvm's private socket, not tmux's default - target it so
# running panes actually repaint instead of silently doing nothing.
if [ -n "$TMUX" ]; then
  TMUX_CMD="tmux -S ${TMUX%%,*}"
elif [ -S "$HOME/.devvm/tmux.sock" ]; then
  TMUX_CMD="tmux -S $HOME/.devvm/tmux.sock"
else
  TMUX_CMD="tmux"
fi

# --- OS/desktop theme switching ---

# Set macOS appearance explicitly ($1 is "dark" or "light") so re-selecting the
# current mode is a no-op rather than a flip.
switch_macos_theme() {
  if [ "$1" = "dark" ]; then
    osascript -e 'tell app "System Events" to tell appearance preferences to set dark mode to true'
  else
    osascript -e 'tell app "System Events" to tell appearance preferences to set dark mode to false'
  fi
}

switch_linux_desktop_dark() {
  dconf write /org/gnome/desktop/interface/color-scheme "'prefer-dark'"
  gsettings set org.cinnamon.desktop.wm.preferences theme Mint-Y-Dark
  gsettings set org.cinnamon.desktop.interface gtk-theme Mint-Y-Dark
  gsettings set org.cinnamon.theme name Mint-Y-Dark
  notify-send "Switched to dark mode"
}

switch_linux_desktop_light() {
  dconf write /org/gnome/desktop/interface/color-scheme "'prefer-light'"
  gsettings set org.cinnamon.desktop.wm.preferences theme Mint-Y
  gsettings set org.cinnamon.desktop.interface gtk-theme Mint-Y
  gsettings set org.cinnamon.theme name Mint-Y
  notify-send "Switched to light mode"
}

# --- Shared helpers ---

switch_vim_theme() {
  $TMUX_CMD list-panes -a -F '#{pane_id} #{pane_current_command}' |
    grep -E 'nvim|vim' |
    cut -d ' ' -f 1 |
    xargs -I PANE $TMUX_CMD send-keys -t PANE Escape \
      ":set background=$1" Enter
}

# Point the alacritty override at $1's theme file by copying it over
# ALACRITTY_ACTIVE. No-op if the theme file is absent (e.g. alacritty not
# installed, or in a headless guest).
#
# Then bump the primary config's mtime: Alacritty's live reload only watches the
# files that existed when it started, so a freshly created/changed override
# import can be missed. Touching the primary (content unchanged, so the tracked
# file stays clean in git) forces a full re-read that picks up the override.
switch_alacritty_theme() {
  [ -f "$ALACRITTY_THEMES/$1" ] || return 0
  cp "$ALACRITTY_THEMES/$1" "$ALACRITTY_ACTIVE"
  [ -e "$ALACRITTY_CONF" ] && touch "$ALACRITTY_CONF"
}

# --- Detect current mode ---

if [ "$OS_TYPE" = "Darwin" ]; then
  IS_DARK=$(osascript -e 'tell app "System Events" to tell appearance preferences to return dark mode')
elif [ "$HAS_DISPLAY" = true ]; then
  case "$(gsettings get org.cinnamon.desktop.interface gtk-theme 2>/dev/null)" in
    *Dark*) IS_DARK="true" ;;
    *)      IS_DARK="false" ;;
  esac
else
  # Headless Linux: fall back to state file
  IS_DARK=$(cat "$THEME_MODE_FILE" 2>/dev/null || echo "false")
fi

# --- Resolve the target mode ---
# In toggle mode, flip the detected mode; otherwise honour the explicit request.
if [ "$MODE" = "toggle" ]; then
  [ "$IS_DARK" = "true" ] && TARGET="light" || TARGET="dark"
else
  TARGET="$MODE"
fi

# --- Apply ---

if [ "$TARGET" = "light" ]; then
  # Switch to light
  if [ "$OS_TYPE" = "Darwin" ]; then
    switch_macos_theme light
  elif [ "$HAS_DISPLAY" = true ]; then
    switch_linux_desktop_light
  fi
  echo "false" > "$THEME_MODE_FILE"
  switch_alacritty_theme "$ALACRITTY_LIGHTTHEME"
  switch_vim_theme "light"
else
  # Switch to dark
  if [ "$OS_TYPE" = "Darwin" ]; then
    switch_macos_theme dark
  elif [ "$HAS_DISPLAY" = true ]; then
    switch_linux_desktop_dark
  fi
  echo "true" > "$THEME_MODE_FILE"
  switch_alacritty_theme "$ALACRITTY_DARKTHEME"
  switch_vim_theme "dark"
fi

# Reload the tmux theme. catppuccin v2 bakes its palette/colors with `set -ogq`
# (only-if-unset), so switching flavor requires clearing its options first, then
# re-sourcing. Pass every unset plus the source as ONE tmux invocation
# (';'-separated) so the bar repaints once, not once per option.
#
# Inline commands, NOT a temp file sourced by path: under `devvm exec` the
# guest's /tmp can be a private per-exec mount the tmux server can't read, so a
# source-file'd temp silently did nothing (send-keys, used for nvim above, was
# unaffected - which is why nvim switched live but tmux didn't).
if $TMUX_CMD info >/dev/null 2>&1; then
  set --
  for opt in $($TMUX_CMD show-options -g 2>/dev/null | grep -oE '^@(thm_|_ctp|catppuccin_)[a-zA-Z0-9_]*'); do
    set -- "$@" set -gu "$opt" ";"
  done
  $TMUX_CMD "$@" source-file "$REAL_TMUXCONF"
fi

# --- Propagate to live dev VMs (devvm) ---
# For each reachable machine that has its own toggledark, set the SAME mode
# explicitly (never toggle - that could desync a VM from the host). `devvm
# status --plain` prints one `name<TAB>backend<TAB>state` row per machine; a live
# machine is a running smol VM or a reachable remote host (dormant/stopped are
# skipped). devvm is a host-only CLI, so inside a VM this loop finds nothing and
# stops - no recursion.
if command -v devvm >/dev/null 2>&1; then
  devvm status --plain 2>/dev/null |
    awk -F '\t' '$3 == "running" || $3 == "reachable" { print $1 }' |
    while IFS= read -r vm; do
      [ -n "$vm" ] || continue
      # One guest exec: check for toggledark, and set the mode if present. $0 is
      # the VM name (for the message), $1 the target mode.
      devvm exec "$vm" sh -c '
        command -v toggledark >/dev/null 2>&1 || exit 0
        toggledark "$1" && echo "toggledark: set $1 mode on devvm '\''$0'\''"
      ' "$vm" "$TARGET" 2>/dev/null || true
    done
fi
