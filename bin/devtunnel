#!/bin/sh
# Back-compat shim: devtunnel is now `devvm` targeting the scottdev3 machine.
# Config lives in ~/.config/devvm/machines/scottdev3.conf.
case "${1:-status}" in
  start)      exec devvm tunnel scottdev3 up ;;
  stop)       exec devvm tunnel scottdev3 down ;;
  status|"")  exec devvm status scottdev3 ;;
  vnc)        exec devvm vnc  scottdev3 ;;
  mosh)       exec devvm mosh scottdev3 ;;
  help|-h|--help) exec devvm --help ;;
  *)          exec devvm "$@" ;;
esac
