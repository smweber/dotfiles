# ~/.zshrc - deliberately minimal. Real shell config lives in fish, which
# tmux launches via default-command; zsh only needs enough to run the
# ~/.dotfiles/bin tools (devvm etc.) outside tmux.

export PATH="$PATH:$HOME/.dotfiles/bin"

# Native completion for devvm. Keep candidate logic in the executable so zsh
# and fish stay in sync as commands and machine backends change.
if (( ! $+functions[compdef] )); then
    autoload -Uz compinit
    compinit
fi

_devvm() {
    local -a candidates
    candidates=("${(@f)$(command devvm __complete-zsh "$CURRENT" "${words[@]}")}")
    _describe 'devvm value' candidates
}

compdef _devvm devvm
